{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "cd apps/api && npm run serve"
          }
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "cd apps/api && npm run build"
          }
        ]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "cd apps/api && npm start"
          }
        ]
      }
    }
  },
  "tags": ["type:app", "scope:api"]
}
