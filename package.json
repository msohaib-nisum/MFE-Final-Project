{
  "name": "banking-mfe-platform",
  "version": "1.0.0",
  "description": "Banking Micro Frontend Platform - MFE Training Final Project",
  "scripts": {
    "dev": "nx run-many --target=serve --all",
    "dev:all": "concurrently -k -n gateway,accounts,transactions,payments,api -c blue,green,magenta,yellow,red \"npm run start:gateway\" \"npm run start:accounts\" \"npm run start:transactions\" \"npm run start:payments\" \"npm run start:api\"",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "start:gateway": "nx serve gateway",
    "start:accounts": "nx serve mfe-accounts",
    "start:transactions": "nx serve mfe-transactions",
    "start:payments": "nx serve mfe-payments",
    "start:api": "nx serve api"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.14.0",
    "redux": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@nx/express": "^17.3.2",
    "@nx/node": "^17.3.2",
    "@nx/react": "^17.3.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^20.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^11.0.0",
    "@webpack-cli/serve": "^2.0.1",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "nx": "^17.3.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
